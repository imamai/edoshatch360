NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_SERVICE_ROLE_KEY=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Password-reset email is sent by the app, not by Supabase: the stock Supabase
# template was a naked link from onboarding@edoscentre.co.ke, which Gmail
# flagged as a possible phishing attempt. See src/lib/email.ts.
#
# RESEND_FROM_EMAIL must be on a domain (or subdomain) verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@edoshatch360.edoscentre.co.ke

# ── edos.ai (Anthropic) ────────────────────────────────────────────────────────
# Optional. Without ANTHROPIC_API_KEY, edos.ai still answers every question in
# lib/ai/prompts.ts and anything matched by lib/ai/answer.ts — it just cannot
# combine calculations in ways nobody wrote a matcher for. See lib/ai/llm.ts.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
